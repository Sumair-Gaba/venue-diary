{
  "expo": {
    "name": "Venue Diary",
    "slug": "sumair-gaba",
    "owner": "sumairgabas-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "primaryColor": "#A6324F",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.venuediary.app",
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-image",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Venue Diary uses your location to show banquets near you on the map."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#A6324F"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f2571d78-d581-45a9-b8f2-325e7b746309"
      }
    }
  }
}
