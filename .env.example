# Copy this file to `.env` and paste your Neon connection string.
# Get it from https://neon.tech → your project → "Connection string" (Pooled).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Only needed to test photo/video uploads locally. On Vercel this is added
# automatically when a Blob store is connected to the project.
# Get it from: Vercel → project → Storage → your Blob store → ".env.local".
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx
